# Environment
ENVIRONMENT=development

# Database (Default zero-config SQLite, or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./transformiq.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/transformiq_db

# Security & JWT
JWT_SECRET=transformiq-super-secret-jwt-key-for-chaos2commit-2026-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Provider (Options: deterministic_smart, openai, azure_openai)
AI_PROVIDER=deterministic_smart

# OpenAI Configuration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_API_BASE=https://api.openai.com/v1

# Azure OpenAI Configuration (Optional)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview
